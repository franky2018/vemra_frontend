{
  "name": "vemra_frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:gate": "node scripts/audit-gate.mjs",
    "fetch:api": "curl -sS --retry 5 --retry-delay 10 --max-time 90 https://vemra-backend.onrender.com/docs/openapi.json -o docs/openapi.json",
    "generate:api": "openapi-typescript docs/openapi.json -o src/types/api/generated.ts",
    "generate:api:remote": "openapi-typescript https://vemra-backend.onrender.com/docs/openapi.json -o src/types/api/generated.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.64.0",
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "next": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "^2.5.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "zod": "^4.5.4"
  }
}
